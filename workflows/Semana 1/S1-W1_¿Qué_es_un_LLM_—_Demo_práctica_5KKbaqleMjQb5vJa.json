    {
      "id": "bfa8202c-4825-45ec-a93c-e1df6edaed16",
      "name": "✏️ PASO 2 — Escribir pregunta",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5ae810da-3512-5aa5-b5e4-06f8e8821235",
              "name": "pregunta_usuario",
              "type": "string",
              "value": "Necesito responder a un cliente molesto por un retraso y proponer el siguiente paso sin prometer una fecha que todavía no está confirmada."
            }
          ]
        },
        "options": {}
      },
      "position": [
        -160,
        224
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "id": "88d83291-22f7-4d83-ac5e-9a6f881eb64a",
      "name": "🤖 PASO 3 — El LLM responde",
      "parameters": {
        "batching": {},
        "messages": {
          "messageValues": [
            {
              "message": "=ROL: [Lider de SAC]\nOBJETIVO: [Produce analisis completo de la incomodidad del cliente]\nUSUARIO OBJETIVO: [Cliente molesto]\nCONTEXTO AUTORIZADO: [Sector de telecomunicaciones]\nPERSONALIDAD Y TONO: [Con respeto, empatia, criterio]\nREGLAS: [Tener en cuenta una respuesta salominica, porque el cliente podria pedir libro de reclamacion.\nDarle una salida u opcion de otro negocio.]\nRESTRICCIONES Y ESCALAMIENTO: [No llegar hasta el gerente de area]\nHERRAMIENTAS PERMITIDAS: Ninguna en esta práctica; no afirmar que se ejecutaron acciones.\nFORMATO DE SALIDA: [documento de sac, con buen atencion en escala]"
            }
          ]
        },
        "promptType": "define",
        "text": "={{ $json.pregunta_usuario }}"
      },
      "position": [
        112,
        224
      ],
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7
    },
    {
      "id": "d32b3647-202b-426e-b43b-12fd0e0a78bd",
      "name": "📊 PASO 4 — Observar resultado",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ef522b68-7188-5b3b-85db-3c0760c6605d",
              "name": "pregunta",
              "type": "string",
              "value": "={{ $('✏️ PASO 2 — Escribir pregunta').first().json.pregunta_usuario }}"
            },
            {
              "id": "cc251fd1-3f53-55cb-a9c8-01fe584b0c1a",
              "name": "respuesta_llm",
              "type": "string",
              "value": "={{ $json.text ?? $json.output ?? $json.response?.text ?? 'Sin respuesta' }}"
            },
            {
              "id": "2ebe8616-bed8-55e1-ac4a-1f67f74066b7",
              "name": "tokens_aprox_estimados",
              "type": "number",
              "value": "={{ Math.round(String($json.text ?? $json.output ?? $json.response?.text ?? '').length / 4) }}"
            },
            {
              "id": "ac603c1d-369d-57c0-8db5-ed6396c5dfcd",
              "name": "modelo",
              "type": "string",
              "value": "Gemini 2.5 Flash"
            }
          ]
        },
        "options": {}
      },
      "position": [
        512,
