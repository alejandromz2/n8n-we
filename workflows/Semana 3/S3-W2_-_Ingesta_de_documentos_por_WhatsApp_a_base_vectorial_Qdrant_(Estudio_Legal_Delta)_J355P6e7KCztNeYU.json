      "id": "code-extraer-respuesta",
      "name": "Code - Extraer texto de la respuesta",
      "notes": "Defensivo: el campo donde el chain deja el texto (response/text/output) puede variar según la versión de n8n.",
      "notesInFlow": true,
      "parameters": {
        "jsCode": "const original = $('Set - Normalizar pregunta').item.json;\nconst raw = $input.item.json || {};\nconst respuesta = raw.response || raw.text || raw.output || JSON.stringify(raw);\n\nreturn [{\n  json: {\n    remitente: original.remitente,\n    nombre_remitente: original.nombre_remitente,\n    pregunta: original.pregunta,\n    fecha: original.fecha,\n    respuesta\n  }\n}];"
